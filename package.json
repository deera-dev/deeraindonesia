{
  "name": "deeraindonesia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:catalog":    "npm run dev --workspace=apps/catalog",
    "dev:admin":      "npm run dev --workspace=apps/admin",
    "dev:pos":        "npm run dev --workspace=apps/pos",
    "dev:finance":    "npm run dev --workspace=apps/finance",
    "build:catalog":  "npm run build --workspace=apps/catalog",
    "build:admin":    "npm run build --workspace=apps/admin",
    "build:pos":      "npm run build --workspace=apps/pos",
    "build:finance":  "npm run build --workspace=apps/finance",
    "build:all":      "npm run build --workspaces",
    "lint":           "eslint .",
    "lint:fix":       "eslint . --fix",
    "format":         "prettier --write .",
    "format:check":   "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js":                "^9.0.0",
    "eslint":                    "^9.0.0",
    "eslint-config-prettier":    "^9.0.0",
    "eslint-plugin-react":       "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals":                   "^15.0.0",
    "prettier":                  "^3.0.0"
  }
}
